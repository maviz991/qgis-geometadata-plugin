# ==============================================================================
# Este repo (qgis-geometadata-plugin) tem a raiz do .git acidentalmente em
# C:\Users\mdaviz\ (perfil de usuário inteiro) em vez de numa pasta de projeto
# dedicada. Este .gitignore restringe o que é rastreável apenas aos caminhos
# do plugin, para não expor/commitar o resto do perfil por engano.
# ==============================================================================

# Ignora tudo por padrão
/*

# --- Plugin QGIS GeoMetadata ---
!/AppData/
/AppData/*
!/AppData/Roaming/
/AppData/Roaming/*
!/AppData/Roaming/QGIS/
/AppData/Roaming/QGIS/*
!/AppData/Roaming/QGIS/QGIS3/
/AppData/Roaming/QGIS/QGIS3/*
!/AppData/Roaming/QGIS/QGIS3/profiles/
/AppData/Roaming/QGIS/QGIS3/profiles/*
!/AppData/Roaming/QGIS/QGIS3/profiles/default/
/AppData/Roaming/QGIS/QGIS3/profiles/default/*
!/AppData/Roaming/QGIS/QGIS3/profiles/default/python/
/AppData/Roaming/QGIS/QGIS3/profiles/default/python/*
!/AppData/Roaming/QGIS/QGIS3/profiles/default/python/plugins/
/AppData/Roaming/QGIS/QGIS3/profiles/default/python/plugins/*
!/AppData/Roaming/QGIS/QGIS3/profiles/default/python/plugins/GeoMetadata/
!/AppData/Roaming/QGIS/QGIS3/profiles/default/python/plugins/GeoMetadata/**

# --- Notas Obsidian sobre o plugin ---
!/OneDrive - CDHU/
/OneDrive - CDHU/*
!/OneDrive - CDHU/Documentos/
/OneDrive - CDHU/Documentos/*
!/OneDrive - CDHU/Documentos/Obsidian/
/OneDrive - CDHU/Documentos/Obsidian/*
!/OneDrive - CDHU/Documentos/Obsidian/CDHU_Geo/
/OneDrive - CDHU/Documentos/Obsidian/CDHU_Geo/*
!/OneDrive - CDHU/Documentos/Obsidian/CDHU_Geo/GeoMetadata Plugin/
!/OneDrive - CDHU/Documentos/Obsidian/CDHU_Geo/GeoMetadata Plugin/**

# --- Dashboard superSet ---
!/superSet/
!/superSet/**

# --- Arquivos na raiz ---
!/README.md
!/.gitignore
